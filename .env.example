# ============================================================================
# llama-bare-metal — environment configuration
# ============================================================================
# Copy this file to .env and uncomment/edit the lines you want to override.
# All variables are OPTIONAL — every one has a working default in the code.
#
# Layout:
#   # <VAR>=<default>      # <what it does>
# A commented-out line shows the default; an active line overrides it.
# ============================================================================

# ---- Model swap ----------------------------------------------------------
# Default model loaded into llama-backend.service at startup. Any model in
# models.yaml can be requested via the /v1/chat/completions body; this just
# sets the initial load (the first request can still trigger a swap).
#
# gemma 26B IQ2_M (best for 12GB cards, ctx=200k for safety)
MODEL_NAME=unsloth-gemma-4-26b-a4b-it-ud-iq2-m
#
# qwen agentworld 35B IQ2_M (MoE, fast, ctx=200k)
# MODEL_NAME=unsloth-qwen-agentworld-35b-a3b-ud-iq2_m
#
# qwen 3.6 35B IQ2_M (newer MoE, ctx=200k)
# MODEL_NAME=unsloth-qwen3.6-35b-a3b-ud-iq2-m

# ---- Auth (A3) -----------------------------------------------------------
# ROUTER_API_TOKEN=<auto>        # shared-secret bearer token; if unset, a
                                 # random 32-byte token is generated at
                                 # startup. The token is REDACTED in the
                                 # log line — only a fingerprint (first 4 +
                                 # "..." + last 4) is emitted. Loopback
                                 # clients (127.0.0.1, ::1, localhost) bypass
                                 # auth. Set this explicitly so the token
                                 # survives restarts and never appears in
                                 # the journal even as a fingerprint.

# ---- Request body cap (A1) -----------------------------------------------
# MAX_REQUEST_BYTES=33554432     # 32 MiB; bodies larger than this get HTTP
                                 # 413 before any read happens.

# ---- Logging (D1) -------------------------------------------------------
# LOG_FILE=/tmp/llama-router.log  # rotating file handler destination.
# LOG_LEVEL=INFO                  # DEBUG/INFO/WARNING/ERROR/CRITICAL.
# LOG_MAX_BYTES=52428800          # 50 MiB; rotated when exceeded.
# LOG_BACKUP_COUNT=3              # rotated files kept on disk (file.1..N).

# ---- Graceful shutdown (E3) ---------------------------------------------
# DRAIN_TIMEOUT=30                # seconds the SIGTERM handler will wait
                                  # for in-flight requests to finish.

# ---- Health probe (E1) --------------------------------------------------
# HEALTH_CACHE_TTL=5              # seconds the /health probe result is
                                  # cached so high-frequency probes don't
                                  # hammer the backend.

# ---- Backend & systemd glue ---------------------------------------------
# BACKEND_SERVICE=llama-backend.service   # systemd unit the router swaps.
# CUDA_SERVE_URL=http://127.0.0.1:64000   # llama-server base URL.
# CUDA_SERVE_HEALTH=http://127.0.0.1:64000/health  # llama-server health URL.
# BACKEND_STATE_FILE=/run/user/1000/llama-backend.model  # plain-text
                                  # file llama-backend.sh writes the loaded
                                  # model name to on startup.

# ---- Filesystem layout --------------------------------------------------
# MODELS_YAML=/home/fekry/Projects/llama-cpp-unified/models.yaml
                                  # the YAML list of valid model names.
# MODELS_DIR=<see build_args>      # directory the launcher looks in for
                                  # model files (used by llama-backend.sh).
# ENV_DIR=/home/fekry/Projects/llama-bare-metal
                                  # directory holding .env (the router
                                  # writes MODEL_NAME here, atomic).
# ENV_FILE=<ENV_DIR>/.env          # the actual .env path used by the swap.

# ---- Router bind ---------------------------------------------------------
# ROUTER_PORT=64010                # TCP port the router listens on.
# ROUTER_BIND=127.0.0.1            # bind address. Default 127.0.0.1
                                   # (sandbox only). Set to 0.0.0.0 ONLY
                                   # if you intentionally expose this to LAN
                                   # AND require ROUTER_API_TOKEN to be set.

# ---- Swap backoff + circuit breaker (L-3, E2) ---------------------------
# SWAP_CIRCUIT_TRIP_AFTER=10       # consecutive swap failures before the
                                   # circuit breaker trips. After tripping,
                                   # ensure_model_loaded returns 'circuit_open'
                                   # to the proxy (HTTP 503 + Retry-After)
                                   # instead of hammering a broken backend.
# SWAP_CIRCUIT_OPEN_SECONDS=300    # how long the breaker stays open before
                                   # a single retry is allowed.

# ---- Backend bind (launcher.sh) -----------------------------------------
# HOST=127.0.0.1                   # llama-server bind address. Default
                                   # 127.0.0.1 (sandbox only). Set to
                                   # 0.0.0.0 ONLY if you intentionally
                                   # expose this to LAN.

# ---- Watcher (llama-backend-watcher.service) ----------------------------
# HEALTH_URL=http://127.0.0.1:64000/health
# PING_INTERVAL=10                 # seconds between /health probes.
# HEALTH_TIMEOUT=3                 # curl timeout per probe.
# FAIL_THRESHOLD=3                 # consecutive failures before the watcher
                                   # runs `systemctl restart llama-backend.service`.
# BACKEND_SERVICE=llama-backend.service  # which unit to restart.
# STARTUP_GRACE_SEC=60              # seconds the watcher waits, after
                                   # starting, before failing. Defends
                                   # against the backend startup race
                                   # (Type=simple: backend "starts" the
                                   # moment it exec's, but /health isn't
                                   # bound until the model is loaded,
                                   # ~10s later). Without the grace window
                                   # the watcher would restart the backend
                                   # mid-load on every boot.
